// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Kora slice-1 list screen snapshots > pins the English screen 1`] = `"<section aria-labelledby="kora-title" class="mx-auto max-w-4xl space-y-6"><div class="flex flex-wrap items-center gap-3"><h1 id="kora-title" class="text-xl font-semibold">Kora — sessions across all hosts</h1><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-border text-foreground-secondary gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check size-3" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>Kora · slice 1</span></div><p class="max-w-prose text-sm text-foreground-secondary">Live zcode session list from the laptop store (read-only scanner, registry on the board). Transcripts and steering arrive with slices 2–3; the contract stays frozen in docs/kora/openapi.yaml.</p><div class="grid gap-6 md:grid-cols-2"><div class="rounded-md border border-border-subtle bg-well text-foreground shadow-well"><div class="flex flex-col space-y-1.5 p-6"><h3 class="font-semibold flex items-center gap-2 text-base"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye size-4" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg>What I see / what I don&#x27;t</h3></div><div class="p-6 pt-0 space-y-3"><ul class="space-y-2"><li class="flex flex-wrap items-center gap-2 text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye size-4 shrink-0 text-foreground-secondary" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg><span class="font-mono">zcode</span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-transparent bg-elevated text-foreground-secondary">full</span><span class="basis-full text-foreground-secondary">Списки и полные транскрипты (mode=ro + WAL-snapshot-fallback)</span></li><li class="flex flex-wrap items-center gap-2 text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye size-4 shrink-0 text-foreground-secondary" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg><span class="font-mono">vscode</span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-border text-foreground-secondary">lists only</span><span class="basis-full text-foreground-secondary">Списки и превью; полный транскрипт — известный пробел (kind:1)</span></li><li class="flex flex-wrap items-center gap-2 text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye size-4 shrink-0 text-foreground-secondary" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg><span class="font-mono">pi</span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-border text-foreground-secondary">lists only</span><span class="basis-full text-foreground-secondary">Списки по parentId</span></li><li class="flex flex-wrap items-center gap-2 text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye-off size-4 shrink-0 text-foreground-secondary" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path><path d="m2 2 20 20"></path></svg><span class="font-mono">hermes</span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-transparent bg-error/15 text-error">not scanned</span><span class="basis-full text-foreground-secondary">Не сканируется до T004</span></li></ul><div><p class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground-secondary">Known gaps</p><ul class="list-inside list-disc space-y-1 text-sm text-foreground-secondary"><li>Удалённые хосты ждут расписания W4 loopback-ingress</li><li>hermes-сессии не видны до T004</li><li>Полные транскрипты vscode — известный пробел среза 2 (kind:1)</li></ul></div></div></div><div class="rounded-md border border-border-subtle bg-well text-foreground shadow-well"><div class="flex flex-col space-y-1.5 p-6"><h3 class="font-semibold flex items-center gap-2 text-base"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb size-4" aria-hidden="true"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg>Why Kora</h3></div><div class="p-6 pt-0"><ol class="space-y-3 text-sm"><li class="flex gap-3"><span aria-hidden="true" class="flex size-6 shrink-0 items-center justify-center rounded-full bg-well text-xs font-semibold">1</span><div><p class="font-medium">See everything</p><p class="text-foreground-secondary">All zcode, vscode and pi sessions on connected hosts — one list, no console hopping.</p></div></li><li class="flex gap-3"><span aria-hidden="true" class="flex size-6 shrink-0 items-center justify-center rounded-full bg-well text-xs font-semibold">2</span><div><p class="font-medium">Catch up</p><p class="text-foreground-secondary">A read-only transcript of any session: what happened and where it stopped, changing nothing.</p></div></li><li class="flex gap-3"><span aria-hidden="true" class="flex size-6 shrink-0 items-center justify-center rounded-full bg-well text-xs font-semibold">3</span><div><p class="font-medium">Steer from the phone</p><p class="text-foreground-secondary">A new session or a prompt into your own — via the relay; the phone sees the same UI as the desktop.</p></div></li></ol></div></div></div><h2 class="text-lg font-semibold">Sessions</h2><ul class="space-y-3"><li><a class="flex flex-col gap-2 rounded-md border border-border-subtle p-4 transition-colors hover:bg-well focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="/kora/exec-zcode-main%3Asess_7f3a91" data-discover="true"><div class="flex flex-wrap items-center gap-2"><span aria-hidden="true" class="size-2 shrink-0 rounded-full bg-success/15 text-success"></span><span class="font-mono text-sm">zcode</span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-border text-foreground-secondary">live</span><span class="min-w-0 truncate text-sm font-medium">mnemos-mesh</span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-border text-foreground-secondary">relay</span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-border text-foreground-secondary gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-radio size-3" aria-hidden="true"><path d="M16.247 7.761a6 6 0 0 1 0 8.478"></path><path d="M19.075 4.933a10 10 0 0 1 0 14.134"></path><path d="M4.925 19.067a10 10 0 0 1 0-14.134"></path><path d="M7.753 16.239a6 6 0 0 1 0-8.478"></path><circle cx="12" cy="12" r="2"></circle></svg>steerable</span><span class="ml-auto shrink-0 text-xs text-foreground-secondary">age: 2 ч 29 м</span></div><div class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-foreground-secondary"><span class="font-mono">exec-zcode-main</span><span class="font-mono">sess_7f3a91</span><span class="truncate">/var/home/abyss/LABs/Projects/Project-Mnemos/mnemos-mesh</span></div><p class="line-clamp-2 text-sm text-foreground-secondary">Тесты транскрипта зелёные, осталось добавить anti-write кейс для ридера zcode…</p></a></li><li><a class="flex flex-col gap-2 rounded-md border border-border-subtle p-4 transition-colors hover:bg-well focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="/kora/exec-vscode-lab%3Aa83f1c22" data-discover="true"><div class="flex flex-wrap items-center gap-2"><span aria-hidden="true" class="size-2 shrink-0 rounded-full bg-elevated text-foreground-secondary"></span><span class="font-mono text-sm">vscode</span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-border text-foreground-secondary">idle</span><span class="min-w-0 truncate text-sm font-medium">sealbox-ui</span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-border text-foreground-secondary">local</span><span class="ml-auto shrink-0 text-xs text-foreground-secondary">age: 18 ч 2 м</span></div><div class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-foreground-secondary"><span class="font-mono">exec-vscode-lab</span><span class="font-mono">a83f1c22</span><span class="truncate">/var/home/abyss/LABs/Projects/sealbox/ui</span></div><p class="line-clamp-2 text-sm text-foreground-secondary">Refactor settings hub: v2 grid layout, spacing tokens…</p></a></li><li><a class="flex flex-col gap-2 rounded-md border border-border-subtle p-4 transition-colors hover:bg-well focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="/kora/exec-pi-edge%3Api-2209-04" data-discover="true"><div class="flex flex-wrap items-center gap-2"><span aria-hidden="true" class="size-2 shrink-0 rounded-full bg-elevated text-foreground-muted"></span><span class="font-mono text-sm">pi</span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-border text-foreground-secondary">process dead</span><span class="min-w-0 truncate text-sm font-medium">pi-2209-04</span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-border text-foreground-secondary">local</span><span class="ml-auto shrink-0 text-xs text-foreground-secondary">age: 1 сут 23 ч</span></div><div class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-foreground-secondary"><span class="font-mono">exec-pi-edge</span><span class="font-mono">pi-2209-04</span></div><p class="text-sm italic text-foreground-muted">No last-line preview</p></a></li></ul></section>"`;

exports[`Kora slice-1 list screen snapshots > pins the Russian screen (coverage + onboarding + rows) 1`] = `"<section aria-labelledby="kora-title" class="mx-auto max-w-4xl space-y-6"><div class="flex flex-wrap items-center gap-3"><h1 id="kora-title" class="text-xl font-semibold">Кора — сессии всех хостов</h1><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-border text-foreground-secondary gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check size-3" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>Кора · срез 1</span></div><p class="max-w-prose text-sm text-foreground-secondary">Живой список zcode-сессий с ноут-стора (read-only сканер, реестр на борде). Транскрипты и руление — срезы 2–3; контракт заморожен в docs/kora/openapi.yaml.</p><div class="grid gap-6 md:grid-cols-2"><div class="rounded-md border border-border-subtle bg-well text-foreground shadow-well"><div class="flex flex-col space-y-1.5 p-6"><h3 class="font-semibold flex items-center gap-2 text-base"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye size-4" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg>Что вижу / чего нет</h3></div><div class="p-6 pt-0 space-y-3"><ul class="space-y-2"><li class="flex flex-wrap items-center gap-2 text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye size-4 shrink-0 text-foreground-secondary" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg><span class="font-mono">zcode</span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-transparent bg-elevated text-foreground-secondary">полностью</span><span class="basis-full text-foreground-secondary">Списки и полные транскрипты (mode=ro + WAL-snapshot-fallback)</span></li><li class="flex flex-wrap items-center gap-2 text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye size-4 shrink-0 text-foreground-secondary" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg><span class="font-mono">vscode</span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-border text-foreground-secondary">только списки</span><span class="basis-full text-foreground-secondary">Списки и превью; полный транскрипт — известный пробел (kind:1)</span></li><li class="flex flex-wrap items-center gap-2 text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye size-4 shrink-0 text-foreground-secondary" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg><span class="font-mono">pi</span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-border text-foreground-secondary">только списки</span><span class="basis-full text-foreground-secondary">Списки по parentId</span></li><li class="flex flex-wrap items-center gap-2 text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye-off size-4 shrink-0 text-foreground-secondary" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path><path d="m2 2 20 20"></path></svg><span class="font-mono">hermes</span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-transparent bg-error/15 text-error">не сканируется</span><span class="basis-full text-foreground-secondary">Не сканируется до T004</span></li></ul><div><p class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground-secondary">Известные пробелы</p><ul class="list-inside list-disc space-y-1 text-sm text-foreground-secondary"><li>Удалённые хосты ждут расписания W4 loopback-ingress</li><li>hermes-сессии не видны до T004</li><li>Полные транскрипты vscode — известный пробел среза 2 (kind:1)</li></ul></div></div></div><div class="rounded-md border border-border-subtle bg-well text-foreground shadow-well"><div class="flex flex-col space-y-1.5 p-6"><h3 class="font-semibold flex items-center gap-2 text-base"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb size-4" aria-hidden="true"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg>Зачем Кора</h3></div><div class="p-6 pt-0"><ol class="space-y-3 text-sm"><li class="flex gap-3"><span aria-hidden="true" class="flex size-6 shrink-0 items-center justify-center rounded-full bg-well text-xs font-semibold">1</span><div><p class="font-medium">Видеть всё</p><p class="text-foreground-secondary">Все сессии zcode, vscode и pi на подключённых хостах — одним списком, без прыжков по консолям.</p></div></li><li class="flex gap-3"><span aria-hidden="true" class="flex size-6 shrink-0 items-center justify-center rounded-full bg-well text-xs font-semibold">2</span><div><p class="font-medium">Досмотреть</p><p class="text-foreground-secondary">Read-only транскрипт любой сессии: что происходило и на чём остановились, ничего не меняя.</p></div></li><li class="flex gap-3"><span aria-hidden="true" class="flex size-6 shrink-0 items-center justify-center rounded-full bg-well text-xs font-semibold">3</span><div><p class="font-medium">Порулить с телефона</p><p class="text-foreground-secondary">Новая сессия или промпт в свою — через реле; телефон видит тот же интерфейс, что и рабочий стол.</p></div></li></ol></div></div></div><h2 class="text-lg font-semibold">Сессии</h2><ul class="space-y-3"><li><a class="flex flex-col gap-2 rounded-md border border-bord