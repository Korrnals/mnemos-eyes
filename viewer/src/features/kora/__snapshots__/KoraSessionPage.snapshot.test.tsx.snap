exports[`Kora slice-2/3 session screen snapshots > pins the read-only transcript of a LOCAL session with the honest plate 1`] = `"<section aria-labelledby="kora-session-title" class="mx-auto grid max-w-4xl gap-6 lg:grid-cols-[1fr_20rem]"><div class="min-w-0 space-y-4"><div class="flex flex-wrap items-center gap-2"><a class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors duration-instant ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 hover:bg-elevated hover:text-foreground h-8 rounded-sm px-3 text-xs" href="/kora" data-discover="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left size-4" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>К списку сессий</a><h1 id="kora-session-title" class="min-w-0 truncate text-lg font-semibold">sealbox-ui</h1><span aria-hidden="true" class="size-2 rounded-full bg-elevated"></span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-border text-foreground-secondary">ожидает</span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-border text-foreground-secondary">локальная</span><span class="font-mono text-xs text-foreground-secondary">vscode<!-- --> · <!-- -->exec-vscode-lab</span></div><div role="status" class="flex items-start gap-2 rounded-md border border-warning/30 bg-warning/10 p-3 text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock mt-0.5 size-4 shrink-0 text-warning" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg><div><p class="font-medium">Чужая сессия — только чтение</p><p class="text-foreground-secondary">Продолжение доступно только для сессий relay-происхождения или после явного усыновления.</p></div></div><div class="rounded-md border border-border-subtle bg-well text-foreground shadow-well"><div class="flex flex-col space-y-1.5 p-6"><h3 class="font-semibold text-base">Транскрипт (только чтение)</h3></div><div class="p-6 pt-0"><ol class="space-y-3"><li class="flex gap-3 text-sm"><span aria-hidden="true" class="mt-0.5 h-fit shrink-0 rounded-sm px-1.5 py-0.5 text-xs font-medium bg-iris/15 text-iris-bright">user</span><div class="min-w-0"><p class="whitespace-pre-wrap break-words">Refactor settings hub: v2 grid layout, spacing tokens…</p><p class="mt-0.5 flex flex-wrap gap-2 text-xs text-foreground-muted"><span class="font-mono">seq <!-- -->1</span><span>2026-09-23T16:05:00Z</span></p></div></li></ol></div></div></div><aside class="space-y-4"><div class="rounded-md border border-border-subtle bg-well text-foreground shadow-well"><div class="flex flex-col space-y-1.5 p-6"><h3 class="font-semibold text-base">Чат (срез 3)</h3></div><div class="p-6 pt-0"><p class="text-sm text-foreground-secondary">Руление недоступно: сессия локальная. Только чтение — инвариант NO-DRIFT.</p></div></div></aside></section>"`;

exports[`Kora slice-2/3 session screen snapshots > pins the relay session with the chat panel (step-up PIN + send) 1`] = `"<section aria-labelledby="kora-session-title" class="mx-auto grid max-w-4xl gap-6 lg:grid-cols-[1fr_20rem]"><div class="min-w-0 space-y-4"><div class="flex flex-wrap items-center gap-2"><a class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors duration-instant ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 hover:bg-elevated hover:text-foreground h-8 rounded-sm px-3 text-xs" href="/kora" data-discover="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left size-4" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>К списку сессий</a><h1 id="kora-session-title" class="min-w-0 truncate text-lg font-semibold">mnemos-mesh</h1><span aria-hidden="true" class="size-2 rounded-full bg-success"></span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-border text-foreground-secondary">живая</span><span class="inline-flex items-center rounded-sm border px-2 py-0.5 text-xs font-medium transition-colors duration-instant focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright border-border text-foreground-secondary">реле</span><span class="font-mono text-xs text-foreground-secondary">zcode<!-- --> · <!-- -->exec-zcode-main</span></div><div class="rounded-md border border-border-subtle bg-well text-foreground shadow-well"><div class="flex flex-col space-y-1.5 p-6"><h3 class="font-semibold text-base">Транскрипт (только чтение)</h3></div><div class="p-6 pt-0"><ol class="space-y-3"><li class="flex gap-3 text-sm"><span aria-hidden="true" class="mt-0.5 h-fit shrink-0 rounded-sm px-1.5 py-0.5 text-xs font-medium bg-iris/15 text-iris-bright">user</span><div class="min-w-0"><p class="whitespace-pre-wrap break-words">Разведай структуру ридера zcode-стора: что нужно для чтения mode=ro и WAL-snapshot-fallback.</p><p class="mt-0.5 flex flex-wrap gap-2 text-xs text-foreground-muted"><span class="font-mono">seq <!-- -->1</span><span>2026-09-24T09:12:20Z</span></p></div></li><li class="flex gap-3 text-sm"><span aria-hidden="true" class="mt-0.5 h-fit shrink-0 rounded-sm px-1.5 py-0.5 text-xs font-medium bg-elevated text-foreground-secondary">assistant</span><div class="min-w-0"><p class="whitespace-pre-wrap break-words">Стор — db.sqlite в ~/.local/share/zcode/sessions; ридеру достаточно mode=ro; на холодном старте открываем через снапшот. Анти-write-тест закрывает rollback/model-io.</p><p class="mt-0.5 flex flex-wrap gap-2 text-xs text-foreground-muted"><span class="font-mono">seq <!-- -->2</span><span>2026-09-24T09:13:02Z</span></p></div></li><li class="flex gap-3 text-sm"><span aria-hidden="true" class="mt-0.5 h-fit shrink-0 rounded-sm px-1.5 py-0.5 text-xs font-medium bg-confidence/15 text-confidence">tool</span><div class="min-w-0"><p class="whitespace-pre-wrap break-words">read server/kora/zcode_reader.py (128 lines) — [redacted: path inside ~/private]</p><p class="mt-0.5 flex flex-wrap gap-2 text-xs text-foreground-muted"><span class="font-mono">seq <!-- -->3</span><span>2026-09-24T09:13:40Z</span><span title="Часть строки скрыта единым redaction-модулем при выдаче">маскировано</span></p></div></li><li class="flex gap-3 text-sm"><span aria-hidden="true" class="mt-0.5 h-fit shrink-0 rounded-sm px-1.5 py-0.5 text-xs font-medium bg-iris/15 text-iris-bright">user</span><div class="min-w-0"><p class="whitespace-pre-wrap break-words">Тесты транскрипта зелёные? Добавь anti-write кейс.</p><p class="mt-0.5 flex flex-wrap gap-2 text-xs text-foreground-muted"><span class="font-mono">seq <!-- -->4</span><span>2026-09-24T11:40:10Z</span></p></div></li><li class="flex gap-3 text-sm"><span aria-hidden="true" class="mt-0.5 h-fit shrink-0 rounded-sm px-1.5 py-0.5 text-xs font-medium bg-elevated text-foreground-secondary">assistant</span><div class="min-w-0"><p class="whitespace-pre-wrap break-words">Да, 12 passed. Anti-write кейс добавил: попытка записи через ридер падает с ошибкой «database is opened read-only».</p><p class="mt-0.5 flex flex-wrap gap-2 text-xs text-foreground-muted"><span class="font-mono">seq <!-- -->5</span><span>2026-09-24T11:41:00Z</span></p></div></li></ol></div></div></div><aside class="space-y-4"><div class="rounded-md border border-border-subtle bg-well text-foreground shadow-well"><div class="flex flex-col space-y-1.5 p-6"><h3 class="font-semibold text-base">Чат (срез 3)</h3></div><div class="p-6 pt-0 space-y-3"><form class="flex flex-wrap items-center gap-2 rounded-md border border-border-subtle p-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-key-round size-4 shrink-0 text-foreground-secondary" aria-hidden="true"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle></svg><label class="text-sm" for="kora-step-up-pin">PIN руления</label><input type="password" class="flex h-9 rounded-md border border-border bg-well px-3 py-1 text-base transition-colors duration-instant placeholder:text-foreground-muted focus-visible:border-iris-bright focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright disabled:cursor-not-allowed disabled:opacity-50 w-28" id="kora-step-up-pin" inputMode="numeric" autoComplete="off" placeholder="PIN" value=""/><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors duration-instant ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 bg-iris-strong text-foreground-inverse hover:bg-iris-strong-hover h-8 rounded-sm px-3 text-xs" type="submit" disabled="">Включить руление</button><p class="basis-full text-xs text-foreground-secondary">Чтение — без PIN; руление — после короткого PIN-ритуала (step-up, TTL ≤ 15 минут).</p></form><form class="flex items-start gap-2"><label class="sr-only" for="kora-chat-input">Промпт в сессию…</label><input class="flex h-9 w-full rounded-md border border-border bg-well px-3 py-1 text-base transition-colors duration-instant placeholder:text-foreground-muted focus-visible:border-iris-bright focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright disabled:cursor-not-allowed disabled:opacity-50" id="kora-chat-input" placeholder="Промпт в сессию…" value=""/><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors duration-instant ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-iris-bright disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 bg-iris-strong text-foreground-inverse hover:bg-iris-strong-hover h-8 rounded-sm px-3 text-xs" type="submit" disabled=""><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-send size-4" aria-hidden="true"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path><path d="m21.854 2.147-10.94 10.939"></path></svg><span class="sr-only">Отправить</span></button></form><p class="text-xs text-foreground-muted">Свежесть: хвост стора перечитывается, цель ≤60 с</p></div></div></aside></section>"`;
