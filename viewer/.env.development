# Development defaults for the viewer (committed — contains no secrets, ever).
#
# Adapter selection (ADR 0011 Ф0) is VITE_ADAPTER=mock|mnemos|board. The
# code-level default is environment-aware (owner feedback 1.4.0): production
# builds boot "board" (read-only, token-free), dev boots "mock". The legacy
# VITE_MNEMOS_ADAPTER=mock below keeps dev boxes on the in-memory fixtures;
# VITE_ADAPTER wins when both are set. Overrides go on the command line
# (process env beats .env files) or in .env.development.local (gitignored):
#
#   VITE_ADAPTER=mnemos npm run dev                     # live mnemos via dev-proxy
#   VITE_ADAPTER=board npm run dev                      # board merge-API via dev-proxy
#   # (board dev-proxy target defaults to http://127.0.0.1:8140 — override with
#   #  VITE_BOARD_DEV_TARGET=http://host:port)
VITE_MNEMOS_ADAPTER=mock
