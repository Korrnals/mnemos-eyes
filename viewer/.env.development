# Development defaults for the viewer (committed — contains no secrets, ever).
#
# Mock adapter out of the box: `npm run dev` gives you the in-memory fixture
# gateway, no live mnemos required. The code-level default remains "mnemos".
#
# Adapter selection (ADR 0011 Ф0) is VITE_ADAPTER=mock|mnemos|board, default
# "mnemos". The legacy VITE_MNEMOS_ADAPTER=mock below keeps dev boxes on the
# fixtures; VITE_ADAPTER wins when both are set. Overrides go on the command
# line (process env beats .env files) or in .env.development.local (gitignored):
#
#   VITE_ADAPTER=mnemos npm run dev                     # live mnemos via dev-proxy
#   VITE_ADAPTER=board npm run dev                      # board merge-API via dev-proxy
#   # (board dev-proxy target defaults to http://127.0.0.1:8140 — override with
#   #  VITE_BOARD_DEV_TARGET=http://host:port)
VITE_MNEMOS_ADAPTER=mock
