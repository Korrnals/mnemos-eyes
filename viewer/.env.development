# Development defaults for the viewer (committed — contains no secrets, ever).
#
# Mock adapter out of the box: `npm run dev` gives you the in-memory fixture
# gateway, no live mnemos required. The code-level default remains "http".
#
# To browse a live mnemos instead, override on the command line (process env
# beats .env files):
#   VITE_MNEMOS_ADAPTER=http npm run dev
# or keep a private override in .env.development.local (gitignored).
VITE_MNEMOS_ADAPTER=mock
